<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime denies the microphone, without a prompt, to a
	     program signed without this entitlement. The bundler signs the app
	     and its daemon sidecar with it, so an agent in a Caprock terminal
	     (Claude Code's voice mode) gets macOS's one-time prompt (ADR-045). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
